    { "id": "research-12", "category": "research", "triggers": ["random", "start"], "text": "开工前先锁版本、预算、种子和验收指标。" },

    { "id": "evidence-01", "category": "evidence", "triggers": ["random", "reviewing"], "text": "每个数字都得知道从哪个文件、哪次运行来的。" },
    { "id": "evidence-02", "category": "evidence", "triggers": ["random", "thinking"], "text": "原始来源能核，方法才配进你的证据链。" },
    { "id": "evidence-03", "category": "evidence", "triggers": ["random", "running"], "text": "先保存 CSV、MAT、配置和日志，再讨论故事。" },
    { "id": "evidence-04", "category": "evidence", "triggers": ["random", "success"], "text": "结果不错，先别庆功，哈希和复现命令留了吗？" },
    { "id": "evidence-05", "category": "evidence", "triggers": ["random", "failure"], "text": "失败日志也是证据，别让它只活在终端里。" },
