    { "id": "simulation-05", "category": "simulation", "triggers": ["random", "success"], "text": "曲线赢了，实时性、约束和回退也得一起赢。" },
    { "id": "simulation-06", "category": "simulation", "triggers": ["random", "waiting"], "text": "仿真在跑，趁机检查单位、采样时间和初值。" },
    { "id": "simulation-07", "category": "simulation", "triggers": ["random", "running"], "text": "别边跑边换口径，公平预算先冻结。" },
