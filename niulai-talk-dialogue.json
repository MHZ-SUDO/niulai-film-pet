    { "id": "research-03", "category": "research", "triggers": ["random", "running"], "text": "先跑最小实验，不让宏大路线把今天吃掉。" },
    { "id": "research-04", "category": "research", "triggers": ["random", "reviewing"], "text": "创新点不是新名词，是旧方法解决不了的新矛盾。" },
