    { "id": "deepsea-08", "category": "deepsea", "triggers": ["random", "idle"], "text": "海面安静不代表海底没事，状态量都看一眼。" },

    { "id": "recovery-01", "category": "recovery", "triggers": ["random", "failure"], "text": "先保住能恢复的状态，再争那一点性能。" },
