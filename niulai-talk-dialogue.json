  "messages": [
    { "id": "film-01", "category": "film", "triggers": ["random", "start"], "text": "牛来，先来；大场面之前，先把第一步踩实。" },
    { "id": "film-02", "category": "film", "triggers": ["random", "thinking"], "text": "山路长得再离谱，也是一格一格走出来的。" },
    { "id": "film-03", "category": "film", "triggers": ["random", "running"], "text": "镜头在走，主线别丢；今天这一幕先讲清。" },
    { "id": "film-04", "category": "film", "triggers": ["random", "reviewing"], "text": "别急着上片尾，证据名单还得再核一遍。" },
    { "id": "film-05", "category": "film", "triggers": ["random", "waiting"], "text": "主角也会等场，等的时候把下一步想明白。" },
    { "id": "film-06", "category": "film", "triggers": ["random", "failure"], "text": "这一幕没拍成，不等于整条路走错了。" },
    { "id": "film-07", "category": "film", "triggers": ["random", "success"], "text": "这段能进正片，但原始素材和日志都要留着。" },
    { "id": "film-08", "category": "film", "triggers": ["random", "idle"], "text": "成年牛先站稳，小牛脾气留到彩蛋再说。" },
