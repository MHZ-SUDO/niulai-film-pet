    { "id": "film-10", "category": "film", "triggers": ["random", "reviewing"], "text": "情节可以反转，数据口径不能半路换演员。" },
    { "id": "film-11", "category": "film", "triggers": ["random", "click"], "text": "别绊倒，今天不当半导体；石头先标出来。" },
    { "id": "film-12", "category": "film", "triggers": ["click", "failure"], "text": "石头挡路就绕一下，妈妈先不用喊，我在。" },
    { "id": "film-13", "category": "film", "triggers": ["random", "running"], "text": "豹拉一把，今天的进度也往上拽一格。" },
    { "id": "film-14", "category": "film", "triggers": ["random", "success"], "text": "顶住这一格就好，脑门和主线都别松。" },
    { "id": "film-15", "category": "film", "triggers": ["random", "waiting", "idle"], "text": "云雀还在飞，你先把下一步缩成一句话。" },
    { "id": "film-16", "category": "film", "triggers": ["random", "thinking", "idle"], "text": "一声摇篮曲，先把焦虑送进梦里待会儿。" },
    { "id": "film-17", "category": "film", "triggers": ["random", "running"], "text": "八十六分钟太长，先跑一个八分钟的小实验。" },
    { "id": "film-18", "category": "film", "triggers": ["random", "start"], "text": "明天再明天也会到，牛来先陪你顾好现在。" },
    { "id": "film-19", "category": "film", "triggers": ["random", "failure"], "text": "梦里不敢过河，醒来就从最浅的那步过。" },
    { "id": "film-20", "category": "film", "triggers": ["click", "thinking"], "text": "蛇和河先放一边，你现在最怕的是哪个报错？" },
    { "id": "film-21", "category": "film", "triggers": ["click", "failure"], "text": "牛来听见了。先把报错全文喊出来。" },
    { "id": "film-22", "category": "film", "triggers": ["random", "success"], "text": "牛市来不来先不管，证据链得先来。" },
    { "id": "film-23", "category": "film", "triggers": ["random", "reviewing"], "text": "别把任务养得太肥，跑不动就拆成小块。" },
    { "id": "film-24", "category": "film", "triggers": ["random", "reviewing", "failure"], "text": "画面穿帮能成梗，数据穿帮可过不了审。" },
    { "id": "film-25", "category": "film", "triggers": ["random", "start", "running"], "text": "雷霆先别启动，最小可复现实验先启动。" },
    { "id": "film-26", "category": "film", "triggers": ["random", "reviewing"], "text": "细节没看懂先翻日志，不急着安排二刷。" },
    { "id": "film-27", "category": "film", "triggers": ["random", "success"], "text": "电影会梦醒，备份别等醒来才想起。" },
    { "id": "film-28", "category": "film", "triggers": ["random", "hover", "idle"], "text": "云雀负责飞，我负责盯着你的下一步落地。" },
    { "id": "film-29", "category": "film", "triggers": ["random", "click"], "text": "今天不演大勇士，只做一个能复现的小动作。" },
    { "id": "film-30", "category": "film", "triggers": ["random", "success", "idle"], "text": "梦走到最远处，醒来还是从一小步开始。" },

    { "id": "research-01", "category": "research", "triggers": ["random", "start", "thinking"], "text": "先把科学问题说成一句能被证伪的话。" },
