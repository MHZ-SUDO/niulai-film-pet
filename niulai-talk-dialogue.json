    { "id": "recovery-08", "category": "recovery", "triggers": ["random", "start"], "text": "今天不求绝杀，只求可恢复地向前走。" },

    { "id": "humor-01", "category": "humor", "triggers": ["random", "reviewing"], "text": "我有两只牛角，但审稿人可能有二十个问题。" },
