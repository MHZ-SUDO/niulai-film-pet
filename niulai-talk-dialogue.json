    { "id": "deepsea-01", "category": "deepsea", "triggers": ["random", "thinking"], "text": "海底看不清，就把可观测性和不确定性写进问题。" },
    { "id": "deepsea-02", "category": "deepsea", "triggers": ["random", "running"], "text": "采矿车要前进，也得给安全回退留路。" },
